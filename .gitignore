node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
pnpm-lock.yaml

# Next.js / build
.next
.next/
**/.next/
apps/web/.next/
apps/web/.next/**
out/
dist/
build/
public/build/

# Vercel, Turbo, caches
.vercel/
.turbo/
.cache/
.parcel-cache/

# Environment files
.env
.env.local
.env.*.local
.env.production

# Logs
*.log
**/*.log
logs/
**/logs/
.coverage

# AI service logs and caches
apps/ai/logs/
apps/ai/logs/*.log
apps/ai/.cache/
apps/ai/.env.local
apps/ai/.env
apps/ai/.env.*.local

# Jupyter
.ipynb_checkpoints/

# Coverage
coverage/
**/coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
env/
.venv/

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Misc
coverage/
reports/
.cache/
tmp/
temp/

