# MediLocker environment (Next.js server-side)

# MongoDB Atlas (system of record)
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/?appName=YourCluster
MONGODB_DB=medilocker

# Supabase project (object storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=medilocker
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI service (FastAPI) integration
# Use production AI service URL instead of localhost
AI_BASE_URL=https://your-ai-service.com
AI_SERVICE_TOKEN=your-ai-service-token
INTERNAL_AUTH_TOKEN=your-internal-auth-token

# NextAuth / Google OAuth (web app)
# Use production URL instead of localhost
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your-nextauth-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin token for storage initialization API
ADMIN_INIT_TOKEN=your-admin-init-token

# Email configuration
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# Public URLs (accessible from browser)
# Use production URL instead of localhost
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_AI_BASE_URL=https://your-ai-service.com

# OpenRouter API
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key